<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>

    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <module name="NewlineAtEndOfFile"/>

    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="message" value="Trailing whitespace is not allowed."/>
    </module>

    <module name="TreeWalker">
        <module name="UnusedImports"/>
        <module name="IllegalTokenText">
            <property name="tokens" value="STRING_LITERAL"/>
            <property name="format" value="[^\p{ASCII}]"/>
            <property name="message" value="Use ASCII characters only unless justified."/>
        </module>
    </module>

    <module name="SuppressionFilter">
        <property name="file" value="src/main/config/checkstyle-suppressions.xml"/>
        <property name="optional" value="true"/>
    </module>
</module>
