        <Bug pattern="REC_CATCH_EXCEPTION"/>
        <Comment>CORE-SB-301: JVM anonymous helper warnings tolerated until reflection strategy update (CORE-NF-S-301).</Comment>
    </Match>
    <Match>
        <Class name="~net\.openhft\.chronicle\.core\.Jvm\$.*"/>
        <Or>
            <Bug pattern="UMAC_UNCALLABLE_METHOD_OF_ANONYMOUS_CLASS"/>
            <Bug pattern="UC_USELESS_VOID_METHOD"/>
        </Or>
        <Comment>CORE-SB-302: Default OS helpers rely on shell commands; hardening in CORE-NF-S-302.</Comment>
    </Match>

    <!-- CORE-SB-302: OS shell utilities rely on explicit commands; hardening queued as CORE-NF-S-302. -->
